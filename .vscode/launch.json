{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension - ReactION",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build-and-watch",
      "sourceMaps": true
    }
  ]
}
