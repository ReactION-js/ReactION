{
  "name": "ReactION",
  "displayName": "ReactION-BETA",
  "publisher": "ReactION-JS",
  "description": "React Component Visualizer for VS Code",
  "version": "0.2.0",
  "icon": "resources/color.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "ReactION-button": [
        {
          "id": "startExtension",
          "name": "Launch"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ReactION-button",
          "title": "ReactION",
          "icon": "resources/reactionlogo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ReactION.openTree",
        "title": "ReactION: Launch"
      },
      {
        "command": "ReactION.openWeb",
        "title": "ReactION: Embedded Webview"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ReactION-js/ReactION"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "webpack --mode production",
    "watch:webview": "webpack --mode development --watch",
    "lint": "eslint .",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "test:e2e": "mocha out/test/puppeteer.test.js out/test/TreeView.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mocha": "^12.0.2",
    "react": "^19.3.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
