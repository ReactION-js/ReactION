{
  "name": "ReactION",
  "displayName": "ReactION-BETA",
  "publisher": "ReactION-JS",
  "description": "React Component Visualizer for VS Code",
  "version": "0.2.0",
  "icon": "resources/color.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "ReactION-button": [
        {
          "id": "startExtension",
          "name": "Launch"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ReactION-button",
          "title": "ReactION",
          "icon": "resources/reactionlogo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ReactION.openTree",
        "title": "ReactION: Launch"
      },
      {
        "command": "ReactION.openWeb",
        "title": "ReactION: Embedded Webview"
      },
      {
        "command": "ReactION.analyzeSource",
        "title": "ReactION: Analyze Source"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ReactION-js/ReactION"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "webpack --mode production",
    "watch:webview": "webpack --mode development --watch",
    "lint": "eslint .",
    "spike": "node spike/run-spike.js",
    "spike:phase1": "node spike/run-phase1.js",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "test:e2e": "mocha out/test/puppeteer.test.js out/test/TreeView.test.js out/test/openSource.test.js out/test/staticAnalysis.test.js out/test/staticAnalysisHtml.test.js out/test/singleFileComponents.test.js out/test/selectInstance.test.js spike/storeGraphTransform.test.js spike/coverage.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "@xyflow/react": "^12.11.6",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.2",
    "react": "^19.3.0",
    "react-devtools-inline": "8.0.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "source-map": "^0.7.6",
    "style-loader": "^4.0.0",
    "styled-components": "^6.5.3",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0",
    "react-devtools-core": "8.0.0",
    "ts-morph": "^28.0.0",
    "ws": "^8.21.3"
  }
}
